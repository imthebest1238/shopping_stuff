# Your Anthropic API key. Create one at https://platform.claude.com/ (API keys).
ANTHROPIC_API_KEY=

# ---- Optional settings (remove the # to use one) ----

# Which Claude model runs the agent. claude-sonnet-5-5 is cheaper.
# SHOP_MODEL=claude-opus-5-5

# How hard Claude thinks at each step: low, medium or high.
# SHOP_EFFORT=medium

# Use your installed Google Chrome ("chrome") or Edge ("msedge") instead of the bundled Chromium.
# SHOP_BROWSER_CHANNEL=chrome

# Port for the web page at http://127.0.0.1:8000
# SHOP_PORT=8000

# Max Claude calls per message before the agent pauses and waits for you.
# SHOP_MAX_STEPS=150

# Open the web page automatically on start.
# SHOP_OPEN_UI=true
